{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push:*)",
      "Bash(git push *)",
      "Bash(gh:*)",
      "Bash(gh *)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "mcp__github__*"
    ],
    "allow": [
      "Bash(git init)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(docker compose:*)"
    ]
  }
}
