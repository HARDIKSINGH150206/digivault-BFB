# Copy to .env and fill in — never commit the real .env.
# Polygon Amoy testnet RPC endpoint (e.g. from Alchemy, Infura, or a public Amoy RPC).
AMOY_RPC_URL=
# Private key of the deployer wallet, funded with Amoy testnet POL from a faucet.
# 0x-prefixed hex string. This account becomes EvidenceAnchor's `owner`.
DEPLOYER_PRIVATE_KEY=
