# Postgres — the RUNNING APP connects as digivault_app, NOT the root .env's
# migration/owner role. digivault_app is created by
# prisma/migrations/20260915165833_audit_log_insert_only and has
# UPDATE/DELETE revoked on AuditLog at the DB level — see that migration's
# comment for why. Never point this at the superuser role used for
# `prisma migrate`.
DATABASE_URL="postgresql://digivault_app:CHANGE_ME@localhost:5434/digivault?schema=public"

# MinIO (matches docker-compose.yml)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=digivault
MINIO_SECRET_KEY=digivault123
MINIO_BUCKET=digivault-evidence
# Anchor records (merkle-root.json) go to a separate bucket created with
# Object Lock, Compliance mode (CLAUDE.md rule 3). The app creates it on
# first anchor. Locked objects can't be deleted, even by the MinIO root user,
# until retention ends — production must set retention to at least the
# case-file retention period.
MINIO_ANCHOR_BUCKET=digivault-anchors
MINIO_ANCHOR_RETENTION_DAYS=30
# Public, redaction-safe proof files (ADR-022): anonymous read on proofs/*.
MINIO_PUBLIC_PROOF_BUCKET=digivault-public-proofs
# Browser-reachable MinIO origin for public proof URLs (LAN IP / tunnel for demos).
# MINIO_PUBLIC_URL=http://192.168.1.20:9000

# Base URL printed into certificate QR links: <PUBLIC_BASE_URL>/verify?v=&c=&tx=
# Use a LAN IP or tunnel URL so a phone can open it during the demo.
PUBLIC_BASE_URL=http://localhost:3000

# Encrypts per-tile salts (ADR-018). base64 of 32 random bytes:
#   openssl rand -base64 32
# Back it up like the anchoring key: without it, salted versions can't be verified.
SALT_ENCRYPTION_KEY=
SALT_ENCRYPTION_KEY_ID=k1

# Case gazetteer (ADR-034): names confirmed in one document of a case are
# flagged in its other documents. Keyed hashes only; a separate key from the
# salt key. `openssl rand -base64 32`. Unset = gazetteer off (uploads unaffected).
# Changing it starts every case's gazetteer afresh; set GAZETTEER_KEY_ID anew when you do.
GAZETTEER_KEY=
GAZETTEER_KEY_ID=g1

# Polygon Amoy RPC, used by the /anchor route to call EvidenceAnchor.anchorRoot().
# The signer MUST be the contract's `owner` — i.e. the same key used to deploy it
# in packages/contracts/.env. Not duplicated here on purpose: see
# packages/contracts/.env for DEPLOYER_PRIVATE_KEY, read from there directly.
AMOY_RPC_URL=
# Tried after AMOY_RPC_URL on transport errors only (comma-separated;
# empty = no fallback). Default: https://rpc-amoy.polygon.technology
# AMOY_RPC_FALLBACK_URLS=https://rpc-amoy.polygon.technology
# Fee caps for anchoring txs (src/lib/polygon.ts). The RPC suggestion is
# used when lower. An anchor is ~104k gas: 30 gwei priority ≈ 0.003 POL
# (Amoy's minimum priority fee is ~25 gwei).
ANCHOR_MAX_FEE_GWEI=100
ANCHOR_MAX_PRIORITY_FEE_GWEI=30
# How long to wait for a receipt before marking the attempt FAILED. A tx
# that lands later is picked up on retry without a second send.
ANCHOR_CONFIRM_TIMEOUT_MS=180000
# Standalone audit-head anchoring (src/lib/audit-anchor.ts): every N hours,
# skipped when there are no new audit entries. 0 turns it off.
AUDIT_ANCHOR_INTERVAL_HOURS=6
AI_SERVICE_URL=http://localhost:8001

# HMAC secret for session and step-up tokens (see src/lib/auth.ts).
AUTH_SESSION_SECRET=dev-only-change-me

# Only set to true when a reverse proxy you control overwrites
# X-Forwarded-For; otherwise the header is client-controlled
# (see src/lib/request-ip.ts).
DIGIVAULT_TRUST_PROXY=false
